@echo off
rem ============================================================
rem  Performance test one-key script (on-board route, official CI path)
rem  Prereq: board connected via USB-JTAG and powered on.
rem  Flow: sync netlist -> perf PLL (105 MHz) -> bitstream (~45 min)
rem        -> program board + run 20 benchmarks via VIO/JTAG
rem  Output: run_vivado\perf_vio.csv + perf_vio_runs.csv
rem  Prereq done outside this script:
rem    jtag_axi_master.tcl bin_file switched to nscscc_perf allbench image
rem ============================================================
setlocal
set ROOT=D:\code\Vivado\Loogarch_workspace_kimi
set SUB=%ROOT%\t26-perf-submit-trio
set CHIPLAB=%ROOT%\chiplab
set VIVADO=C:\Xilinx\Vivado\2023.2\bin\vivado.bat
set RUNDV=%CHIPLAB%\fpga\nscscc-team\run_vivado
set CPU_MHZ=105
if not "%~1"=="" set CPU_MHZ=%~1
set NETLIST=%SUB%\src\mycpu\mycpu_top.v
if not "%~2"=="" set NETLIST=%~2

echo ==== [1/6] Sync latest netlist to chiplab/IP/myCPU ====
echo Netlist source: %NETLIST%
copy /y "%NETLIST%" "%CHIPLAB%\IP\myCPU\mycpu_top.v" >nul || goto :fail
echo OK

echo ==== [2/6] Check perf allbench image ====
if not exist "%CHIPLAB%\software\examples\nscscc_perf\obj\allbench\inst_data.bin" (echo [FAIL] allbench inst_data.bin missing & goto :fail)
echo OK

echo ==== [3/6] Check JTAG download image points to perf allbench ====
findstr /c:"set bin_file [open \"../../../../software/examples/nscscc_perf/obj/allbench/inst_data.bin\" \"rb\"]" "%RUNDV%\jtag_axi_master.tcl" | findstr /v /c:"#" >nul || (echo [FAIL] bin_file not switched to perf & goto :fail)
echo OK

cd /d %RUNDV% || goto :fail

echo ==== [4/6] Generate perf PLL config (cpu %CPU_MHZ% MHz) ====
call "%VIVADO%" -mode batch -log gen_perf_pll.log -journal gen_perf_pll.jou -source generate_perf_pll.tcl -tclargs %CPU_MHZ% || goto :fail

echo ==== [5/6] Build perf bitstream (project recreated clean, about 45 min) ====
rem Remove stray IP simulation netlists regenerated by past sim runs;
rem they are synthesis-illegal (Synth 8-5832) and reappear after every sim.
del /q "%CHIPLAB%\chip\soc_demo\nscscc-team\xilinx_ip\vio\vio_0_sim_netlist.v" 2>nul
del /q "%CHIPLAB%\chip\soc_demo\nscscc-team\xilinx_ip\vio\vio_0_sim_netlist.vhdl" 2>nul
del /q "%CHIPLAB%\IP\myCPU\xilinx_ip\multiplier\multiplier_sim_netlist.v" 2>nul
del /q "%CHIPLAB%\IP\myCPU\xilinx_ip\multiplier\multiplier_sim_netlist.vhdl" 2>nul
call "%VIVADO%" -mode batch -log bit_perf.log -journal bit_perf.jou -source "%ROOT%\exam_prep\fpga\tcl\build_perf_bit.tcl" -tclargs perf %CPU_MHZ% || goto :fail
if not exist project\loongson.runs\impl_1\soc_top.bit (echo [FAIL] bitstream not found & goto :fail)
type project\loongson.runs\impl_1\clock_timing_validation.txt

echo ==== [6/6] Program board and run 20 perf benchmarks (VIO) ====
rem vio.tcl sources ../jtag_axi_master.tcl -> must run with cwd = project dir
cd /d %RUNDV%\project || goto :fail
call "%VIVADO%" -mode batch -log ..\vio_perf.log -journal ..\vio_perf.jou -source ..\vio.tcl -tclargs loongson.runs/impl_1/soc_top.bit loongson.runs/impl_1/soc_top.ltx perf
set VIO_RC=%errorlevel%
cd /d %RUNDV%

echo.
echo ---- perf_vio.csv ----
if exist project\perf_vio.csv type project\perf_vio.csv
if %VIO_RC%==0 (
  echo ========== PERF board run finished PASS ==========
  exit /b 0
)
echo ########## PERF board run FAIL/error, check vio_perf.log ##########
goto :fail

:fail
echo.
echo ########## perf_test_board failed ##########
exit /b 1
